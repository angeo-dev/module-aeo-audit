<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <angeo_aeo>
            <crux>
                <api_key></api_key>
            </crux>

            <!--
                Per-signal on/off switches. Every signal is ENABLED (1) by
                default so a fresh install audits all 17 checks. Keys match
                each checker's getCode().
            -->
            <general>
                <!-- 1 = show example fix-module suggestions; 0 = fully vendor-neutral output -->
                <show_fix_suggestions>1</show_fix_suggestions>
            </general>

            <!-- Scheduled audit cron expression (crontab.xml reads this path). -->
            <cron>
                <schedule>0 3 * * 1</schedule>
            </cron>

            <!-- Live-signal evidence sources (since 4.0.0). -->
            <live_signal>
                <instrumentation_enabled>1</instrumentation_enabled>
                <access_log_path></access_log_path>
                <window_days>30</window_days>
                <retention_days>90</retention_days>
            </live_signal>

            <signals>
                <robots_txt>1</robots_txt>
                <llms_txt>1</llms_txt>
                <llms_jsonl>1</llms_jsonl>
                <sitemap>1</sitemap>
                <product_schema>1</product_schema>
                <merchant_policies>1</merchant_policies>
                <organization_schema>1</organization_schema>
                <ucp_profile>1</ucp_profile>
                <ai_product_feed>1</ai_product_feed>
                <jsonld_quality>1</jsonld_quality>
                <canonical>1</canonical>
                <open_graph>1</open_graph>
                <faq_schema>1</faq_schema>
                <well_known>1</well_known>
                <core_web_vitals>1</core_web_vitals>
                <waf_reality>1</waf_reality>
                <ai_crawler_activity>1</ai_crawler_activity>
            </signals>

            <!-- Sitemap checker tuning. -->
            <sitemap>
                <!-- score = placeholder slugs lower the score; ignore = report only -->
                <placeholder_slug_mode>score</placeholder_slug_mode>
                <!-- how many placeholder slugs are tolerated before the score is affected -->
                <placeholder_slug_threshold>1</placeholder_slug_threshold>
            </sitemap>
        </angeo_aeo>
    </default>
</config>
