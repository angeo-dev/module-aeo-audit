<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="angeo_aeo_audit_result" resource="default" engine="innodb"
           comment="Angeo AEO Audit Results">

        <column xsi:type="int"       name="id"           unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar"   name="store_code"   length="64"     nullable="false"                 comment="Store Code"/>
        <column xsi:type="varchar"   name="store_url"    length="255"    nullable="false"                 comment="Store URL"/>
        <column xsi:type="smallint"  name="score"        unsigned="true" nullable="false" default="0"     comment="Score %"/>
        <column xsi:type="varchar"   name="score_label"  length="32"     nullable="false"                 comment="Score Label"/>
        <column xsi:type="smallint"  name="pass_count"   unsigned="true" nullable="false" default="0"     comment="Pass Count"/>
        <column xsi:type="smallint"  name="warn_count"   unsigned="true" nullable="false" default="0"     comment="Warn Count"/>
        <column xsi:type="smallint"  name="fail_count"   unsigned="true" nullable="false" default="0"     comment="Fail Count"/>
        <!-- mediumtext (16 MB): 15 checkers with detail payloads can exceed the 64 KB `text` limit,
             which silently truncates and corrupts the stored JSON. -->
        <column xsi:type="mediumtext" name="checks_json" nullable="false"                                 comment="Checks JSON"/>
        <column xsi:type="varchar"   name="triggered_by" length="32"     nullable="false" default="manual" comment="Triggered By: manual|cron|api"/>
        <column xsi:type="timestamp" name="created_at"   nullable="false" default="CURRENT_TIMESTAMP"    comment="Created At"
                on_update="false"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <index referenceId="ANGEO_AEO_AUDIT_RESULT_STORE_CODE" indexType="btree">
            <column name="store_code"/>
        </index>
        <index referenceId="ANGEO_AEO_AUDIT_RESULT_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <!-- Aggregated AI-bot hit counters (since 4.0.0).
         PRIVACY: counters only — no IPs, no URLs, no raw user agents are ever
         stored. Retention enforced by cron (default 90 days). -->
    <table name="angeo_aeo_bot_hit" resource="default" engine="innodb"
           comment="Angeo AEO Bot Hit Counters">

        <column xsi:type="int"       name="id"        unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar"   name="bot_code"  length="64"     nullable="false"                 comment="Bot Code"/>
        <column xsi:type="varchar"   name="bot_class" length="16"     nullable="false"                 comment="Bot Class: training|search|fetcher"/>
        <column xsi:type="smallint"  name="store_id"  unsigned="true" nullable="false" default="0"     comment="Store ID"/>
        <column xsi:type="date"      name="hit_date"                  nullable="false"                 comment="Hit Date"/>
        <column xsi:type="int"       name="hits"      unsigned="true" nullable="false" default="0"     comment="Hit Count"/>
        <column xsi:type="timestamp" name="last_seen"                 nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Last Seen"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <!-- Uniqueness drives the atomic INSERT ... ON DUPLICATE KEY UPDATE upsert. -->
        <constraint xsi:type="unique" referenceId="ANGEO_AEO_BOT_HIT_BOT_CODE_STORE_ID_HIT_DATE">
            <column name="bot_code"/>
            <column name="store_id"/>
            <column name="hit_date"/>
        </constraint>

        <index referenceId="ANGEO_AEO_BOT_HIT_STORE_ID_HIT_DATE" indexType="btree">
            <column name="store_id"/>
            <column name="hit_date"/>
        </index>
    </table>
</schema>
